---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import PrevNext from '../../../../components/PrevNext.astro';
const headings = [
  { id: 'graph-visualization', text: 'Graph Visualization', depth: 2 },
  { id: 'visual-language', text: 'Visual language', depth: 2 },
