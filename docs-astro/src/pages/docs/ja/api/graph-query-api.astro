---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import Callout from '../../../../components/Callout.astro';
import PrevNext from '../../../../components/PrevNext.astro';
const headings = [
  { id: 'graph-query-api', text: 'Graph Query API', depth: 2 },
  { id: 'quira-graph-query', text: 'quira.graph.query()', depth: 2 },
  { id: 'quira-graph-getrelated', text: 'quira.graph.getRelated()', depth: 2 },
  { id: 'quira-graph-getnode', text: 'quira.graph.getNode()', depth: 2 },
  { id: 'quira-graph-search', text: 'quira.graph.search()', depth: 2 },
  { id: 'quira-graph-export', text: 'quira.graph.export()', depth: 2 },
