import PrevNext from '../../../../components/PrevNext.astro';
const headings = [
  { id: 'for-writers', text: 'ライター & コンテンツクリエイター向け', depth: 2 },
  { id: 'research-pipeline', text: 'リサーチから記事へのパイプライン', depth: 2 },
  { id: 'source-organization', text: 'ソース素材の整理', depth: 2 },
  { id: 'fact-checking', text: 'ファクトチェックワークフロー', depth: 2 },
