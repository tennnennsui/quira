            <div>
              <p style="color:#FAF9F5;font-weight:600;margin:0 0 0.75rem;">Project</p>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem;">
                <li><a href="https://github.com/tennnennsui/quira/blob/main/ROADMAP.md" style="color:#9C9A92;text-decoration:none;">Roadmap</a></li>
                <li><a href="https://github.com/tennnennsui/quira/releases" style="color:#9C9A92;text-decoration:none;">Releases</a></li>
                <li><a href={`${base}/contributing/dev-setup/`} style="color:#9C9A92;text-decoration:none;">Contributing</a></li>
