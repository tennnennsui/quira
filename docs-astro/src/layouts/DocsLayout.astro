  </main>

  <AskDocs lang={lang} />

  <script is:inline>
    function initDocsPage() {
      // Mobile sidebar toggle
      var menuToggle = document.getElementById('menu-toggle');
      var leftSidebar = document.getElementById('left-sidebar');
      var sidebarOverlay = document.getElementById('sidebar-overlay');
      if (menuToggle && leftSidebar && sidebarOverlay) {
        menuToggle.onclick = function() {
          leftSidebar.classList.toggle('open');
          sidebarOverlay.style.display = leftSidebar.classList.contains('open') ? 'block' : 'none';
        };
        sidebarOverlay.onclick = function() {
          leftSidebar.classList.remove('open');
          sidebarOverlay.style.display = 'none';
        };
      }

      // Header shadow on scroll (cleanup old listener to prevent VT accumulation)
      var headerEl = document.querySelector('header');
      if (headerEl) {
        if (window.__headerScrollHandler) window.removeEventListener('scroll', window.__headerScrollHandler);
        window.__headerScrollHandler = function() {
          headerEl.classList.toggle('header-scrolled', window.scrollY > 0);
        };
        window.addEventListener('scroll', window.__headerScrollHandler);
      }

      // Search modal
      var searchModal = document.getElementById('search-modal');
      var searchBackdrop = document.getElementById('search-backdrop');
      var sidebarSearchBtn = document.getElementById('sidebar-search-btn');

      function openSearch() {
        if (searchModal) { searchModal.style.display = ''; searchModal.classList.remove('hidden'); var input = searchModal.querySelector('input'); if (input) input.focus(); }
      }
      function closeSearch() {
        if (searchModal) { searchModal.classList.add('hidden'); searchModal.style.display = 'none'; }
      }
      if (sidebarSearchBtn) sidebarSearchBtn.onclick = openSearch;
      if (searchBackdrop) searchBackdrop.onclick = closeSearch;

      if (window.__searchKeyHandler) document.removeEventListener('keydown', window.__searchKeyHandler);
      window.__searchKeyHandler = function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); searchModal && searchModal.classList.contains('hidden') ? openSearch() : closeSearch(); }
        if (e.key === 'Escape') closeSearch();
      };
      document.addEventListener('keydown', window.__searchKeyHandler);

      // Sidebar section toggle
      document.querySelectorAll('.nav-section-btn').forEach(function(btn) {
        btn.onclick = function() {
          var chevron = btn.querySelector('.chevron');
          var items = btn.parentElement.querySelector('.nav-items');
          if (!chevron || !items) return;
          var isOpen = chevron.classList.contains('open');
          if (isOpen) { chevron.classList.remove('open'); items.style.display = 'none'; }
          else { chevron.classList.add('open'); items.style.display = 'block'; }
        };
      });

      // TOC scroll-spy with track thumb
      var tocLinks = document.querySelectorAll('#toc-nav .toc-link');
      var tocThumb = document.getElementById('toc-thumb');
      var sections = document.querySelectorAll('.content-section');

      function updateTocThumb(activeLink) {
        if (!tocThumb || !activeLink) return;
        var container = activeLink.parentElement;
        if (!container) return;
        var containerRect = container.getBoundingClientRect();
        var linkRect = activeLink.getBoundingClientRect();
        tocThumb.style.top = (linkRect.top - containerRect.top) + 'px';
        tocThumb.style.height = linkRect.height + 'px';
      }

      if (window.__tocObserver) { window.__tocObserver.disconnect(); window.__tocObserver = null; }

      if (sections.length > 0 && tocLinks.length > 0) {
        // Set initial thumb position
        var initialActive = document.querySelector('#toc-nav .toc-link.active');
        if (initialActive) requestAnimationFrame(function() { updateTocThumb(initialActive); });

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var id = entry.target.id;
              tocLinks.forEach(function(link) {
                var isMatch = link.getAttribute('href') === '#' + id;
                link.classList.toggle('active', isMatch);
                if (isMatch) updateTocThumb(link);
              });
            }
          });
        }, { root: null, rootMargin: '-80px 0px -70% 0px', threshold: 0 });
        sections.forEach(function(section) { observer.observe(section); });
        window.__tocObserver = observer;
      }

      // Mobile/tablet menu button visibility (cleanup old listener)
      var mobileBtn = document.getElementById('menu-toggle');
      if (mobileBtn) {
        if (window.__resizeHandler) window.removeEventListener('resize', window.__resizeHandler);
        window.__resizeHandler = function() {
          mobileBtn.style.display = window.innerWidth <= 1024 ? 'block' : 'none';
        };
        window.__resizeHandler();
        window.addEventListener('resize', window.__resizeHandler);
      }

      // Code copy buttons
      document.querySelectorAll('article pre').forEach(function(pre) {
        if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;
        var wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        wrapper.style.cssText = 'position:relative;';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        var btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.style.cssText = 'position:absolute;top:8px;right:8px;padding:4px 8px;background:rgba(222,220,209,0.1);border:1px solid rgba(222,220,209,0.15);border-radius:6px;color:#9C9A92;cursor:pointer;font-size:12px;font-family:inherit;';
        btn.textContent = 'Copy';
        btn.addEventListener('click', function() {
          var code = pre.querySelector('code');
          var text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text).then(function() {
            btn.textContent = '\u2713';
            setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
          });
        });
        wrapper.appendChild(btn);
      });

      // Keyboard navigation (cleanup old listener)
      if (window.__navKeyHandler) document.removeEventListener('keydown', window.__navKeyHandler);
      window.__navKeyHandler = function(e) {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        var prevLink = document.querySelector('.prev-link');
        var nextLink = document.querySelector('.next-link');
        if (e.key === 'ArrowLeft' && prevLink) prevLink.click();
        if (e.key === 'ArrowRight' && nextLink) nextLink.click();
      };
      document.addEventListener('keydown', window.__navKeyHandler);

      // Page feedback widget
      var feedbackWidget = document.getElementById('feedback-widget');
      if (feedbackWidget) {
        var pagePath = window.location.pathname;
        var storageKey = 'feedback:' + pagePath;
        var stored = null;
        try { stored = localStorage.getItem(storageKey); } catch(e) {}
        if (stored) {
          showFeedbackState(feedbackWidget, stored);
        }
        feedbackWidget.querySelectorAll('.feedback-btn').forEach(function(btn) {
          btn.addEventListener('mouseenter', function() { btn.style.borderColor = 'rgba(222,220,209,0.4)'; btn.style.color = '#FAF9F5'; });
          btn.addEventListener('mouseleave', function() {
            if (!btn.classList.contains('selected')) { btn.style.borderColor = 'rgba(222,220,209,0.15)'; btn.style.color = '#9C9A92'; }
          });
          btn.onclick = function() {
            var value = btn.getAttribute('data-value');
            try { localStorage.setItem(storageKey, value); } catch(e) {}
            showFeedbackState(feedbackWidget, value);
          };
        });
      }

      function showFeedbackState(widget, value) {
        widget.querySelectorAll('.feedback-btn').forEach(function(b) {
          var isSelected = b.getAttribute('data-value') === value;
          b.classList.toggle('selected', isSelected);
          if (isSelected && value === 'good') {
            b.style.borderColor = '#4ade80'; b.style.color = '#4ade80'; b.style.background = 'rgba(74,222,128,0.1)';
          } else if (isSelected && value === 'bad') {
            b.style.borderColor = '#f87171'; b.style.color = '#f87171'; b.style.background = 'rgba(248,113,113,0.1)';
          } else {
            b.style.borderColor = 'rgba(222,220,209,0.15)'; b.style.color = '#9C9A92'; b.style.background = 'transparent';
          }
        });
        var msg = widget.querySelector('.feedback-msg');
        if (!msg) {
          msg = document.createElement('span');
          msg.className = 'feedback-msg';
          msg.style.cssText = 'font-size:13px;color:#9C9A92;transition:opacity 0.3s;';
          widget.appendChild(msg);
        }
        var selectedBtn = widget.querySelector('.feedback-btn[data-value="' + value + '"]');
        msg.textContent = selectedBtn ? selectedBtn.getAttribute('data-response') : '';
      }

      // Client-side search (cache on window to survive VT navigation)
      var searchInput = document.querySelector('.search-input');
      var searchResults = document.getElementById('search-results');

      async function loadSearchIndex() {
        if (!window.__searchIndex) {
          try {
            var res = await fetch('/docs/search-index.json');
            window.__searchIndex = await res.json();
          } catch(e) { window.__searchIndex = []; }
        }
        return window.__searchIndex;
      }

      function renderSearchResults(results, query) {
        if (!searchResults) return;
        searchResults.replaceChildren();
        if (!query) {
          var p1 = document.createElement('p');
          p1.style.textAlign = 'center';
          p1.textContent = document.documentElement.lang === 'ja' ? '\u691C\u7D22\u30EF\u30FC\u30C9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044...' : 'Start typing to search the documentation...';
          searchResults.appendChild(p1);
          return;
        }
        if (results.length === 0) {
          var noResult = document.createElement('p');
          noResult.style.cssText = 'color:#9C9A92;text-align:center;';
          noResult.textContent = (document.documentElement.lang === 'ja' ? '\u898B\u3064\u304B\u308A\u307E\u305B\u3093\u3067\u3057\u305F\uFF1A' : 'No results found for ') + '"' + query + '"';
          searchResults.appendChild(noResult);
          return;
        }
        results.forEach(function(r) {
          var a = document.createElement('a');
          a.href = r.path;
          a.style.cssText = 'display:block;padding:8px 12px;border-radius:8px;color:#FAF9F5;text-decoration:none;margin-bottom:2px;';
          a.addEventListener('mouseover', function() { a.style.background = 'rgba(222,220,209,0.06)'; });
          a.addEventListener('mouseout', function() { a.style.background = 'transparent'; });
          var titleDiv = document.createElement('div');
          titleDiv.style.cssText = 'font-size:14px;font-weight:500;';
          titleDiv.textContent = r.title;
          var sectionDiv = document.createElement('div');
          sectionDiv.style.cssText = 'font-size:12px;color:#9C9A92;';
          sectionDiv.textContent = r.section;
          a.appendChild(titleDiv);
          a.appendChild(sectionDiv);
          searchResults.appendChild(a);
        });
      }

      if (searchInput && searchResults) {
        searchInput.addEventListener('input', async function() {
          var query = this.value.toLowerCase().trim();
          if (!query) { renderSearchResults([], ''); return; }
          var index = await loadSearchIndex();
          var currentLang = document.documentElement.lang || 'en';
          var results = index.filter(function(page) {
            return page.lang === currentLang && (
              page.title.toLowerCase().includes(query) ||
              page.keywords.some(function(k) { return String(k).toLowerCase().includes(query); }) ||
              page.section.toLowerCase().includes(query)
            );
          });
          renderSearchResults(results, query);
        });
      }
    }

    // Hide skeleton and show content
    function showContent() {
      var skeleton = document.getElementById('skeleton-loader');
      var article = document.querySelector('article');
      var toc = document.querySelector('.right-toc');

      if (skeleton) {
        skeleton.style.transition = 'opacity 0.2s ease';
        skeleton.style.opacity = '0';
        setTimeout(function() { skeleton.style.display = 'none'; }, 200);
      }
      if (article) article.style.opacity = '1';
      if (toc) toc.style.opacity = '1';
    }

    // Show skeleton and hide content
    function showSkeleton() {
      var skeleton = document.getElementById('skeleton-loader');
      var article = document.querySelector('article');
      var toc = document.querySelector('.right-toc');

      if (article) article.style.opacity = '0';
      if (toc) toc.style.opacity = '0';
      if (skeleton) {
        skeleton.style.display = 'block';
        skeleton.style.opacity = '1';
      }
    }



    // Always run on script execution (initial load + VT re-execution)
    showContent();
    initDocsPage();

    // Register lifecycle handlers only once (is:inline re-executes on every VT navigation)
    if (!window.__docsLifecycleInit) {
      window.__docsLifecycleInit = true;

      document.addEventListener('astro:after-swap', function() {
        initDocsPage();
        showContent();
      });

      document.addEventListener('astro:before-preparation', function() {
        showSkeleton();
      });

      document.addEventListener('astro:page-load', function() {
        showContent();
      });
    }

    // Save language preference
    try {
      var currentLang = document.documentElement.lang;
      if (currentLang === 'en' || currentLang === 'ja') {
        localStorage.setItem('quira-docs-lang', currentLang);
      }
    } catch(e) {}
  </script>
</body>
</html>
